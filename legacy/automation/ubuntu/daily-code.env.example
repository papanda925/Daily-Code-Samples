# このファイルは例です。本番値や秘密情報を書いてcommitしないでください。

POSTBOT_ROOT=/opt/blog-bot
DAILY_CODE_REPO=/opt/Daily-Code-Samples
WP_PATH=/var/www/wordpress
WP_BIN=wp

# 公開サンプルは安全側としてdraftを推奨。
# 本番で完全自動公開する場合だけ、非公開設定でpublishへ変更します。
DAILY_CODE_WP_STATUS=draft

# WordPressへDaily Codeを流す時間帯。
DAILY_CODE_HOUR=14
DAILY_CODE_GRACE_MINUTES=10

# #301以降を1日1本増やす処理。
# Codex CLIとGit push環境を確認した本番だけ 1 にします。
DAILY_SAMPLE_GENERATOR_ENABLED=0
DAILY_SAMPLE_GENERATE_HOUR=6
DAILY_SAMPLE_GENERATE_GRACE_MINUTES=10
CODEX_BIN=codex

BLOG_DISPATCHER=/opt/blog-bot/tools/production_dispatcher.py
GIT_BRANCH=main

# GitHub remoteから自動判定できない場合のみ指定
# GITHUB_REPOSITORY=owner/Daily-Code-Samples

# 状態ファイルを変更する場合
# DAILY_CODE_STATE=/var/lib/daily-code-wordpress/state.json
# DAILY_SAMPLE_GENERATOR_STATE=/var/lib/daily-code-generator/state.json
